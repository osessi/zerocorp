{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/ai"
    },
    {
      "path": "../../packages/application"
    },
    {
      "path": "../../packages/auth"
    },
    {
      "path": "../../packages/billing"
    },
    {
      "path": "../../packages/config"
    },
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/design-system"
    },
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/notifications"
    },
    {
      "path": "../../packages/security"
    },
    {
      "path": "../../packages/tenancy"
    },
    {
      "path": "../../packages/ui"
    }
  ],
  "exclude": [
    "node_modules"
  ]
}
