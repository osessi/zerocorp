# ZeroCorp — environment template. Never commit a real .env file.
# Each application receives only the credentials it is entitled to.

# --- apps/app and apps/worker : read-write role
DATABASE_URL="postgresql://zerocorp_app:CHANGEME@localhost:5432/zerocorp"

# --- apps/sites : READ-ONLY role. This is a security boundary, not a convention.
#     CREATE ROLE zerocorp_sites LOGIN;
#     GRANT SELECT ON ALL TABLES IN SCHEMA public TO zerocorp_sites;
#     Combined with SET LOCAL TRANSACTION READ ONLY in withTenant().
SITES_DATABASE_URL="postgresql://zerocorp_sites:CHANGEME@localhost:5432/zerocorp"

# --- Integration tests. When unset, the tenant-isolation integration suite is skipped.
TEST_DATABASE_URL=""

NODE_ENV="development"
